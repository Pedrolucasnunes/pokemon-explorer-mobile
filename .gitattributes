# Classificação de linguagens do GitHub (Linguist).
#
# Por padrão o GitHub contabilizava apenas 108 bytes de JavaScript
# (o babel.config.js), ignorando os outros 79 KB da aplicação principal.
# As duas primeiras regras desfazem a exclusão automática da árvore do
# React Native; a terceira força a detecção dos arquivos .js.

react-native-pokemon-explorer/**  linguist-vendored=false
react-native-pokemon-explorer/**  linguist-generated=false

*.js    linguist-detectable=true
*.js    linguist-language=JavaScript
*.dart  linguist-language=Dart

# Arquivos gerados por ferramenta — fora da contagem.
react-native-pokemon-explorer/package-lock.json  linguist-generated=true
flutter-tela-pokemon/android/**                  linguist-generated=true

# Screenshots e GIF do README.
docs/**  linguist-documentation=true
